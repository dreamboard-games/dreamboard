{
  "name": "dreamboard-cli",
  "version": "0.1.30-alpha.3",
  "description": "Design board games with AI and turn ideas into playable digital prototypes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard.git"
  },
  "homepage": "http://dreamboard.games/",
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dreamboard",
    "cli",
    "game-dev",
    "board-game",
    "multiplayer"
  ],
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "dreamboard": "dist/index.js"
  },
  "scripts": {
    "dev": "$HOME/.bun/bin/bun run scripts/dev.ts",
    "test": "bun run scripts/test.ts",
    "test:unit": "bun run scripts/test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck && tsup && pnpm run copy:dev-host-assets",
    "build:published": "DREAMBOARD_BUILD_CHANNEL=published tsup && pnpm run copy:dev-host-assets",
    "build:agent-verifier": "tsup --config tsup.agent-verifier.config.ts",
    "copy:dev-host-assets": "tsx scripts/copy-dev-host-assets.ts",
    "stage:publish": "pnpm run build:published && pnpm run build:agent-verifier && tsx scripts/stage-publish.ts",
    "stage:install-smoke-package": "tsx scripts/stage-install-smoke-package.ts",
    "pack:publish": "pnpm run stage:publish && npm pack --dry-run .publish/package"
  },
  "dependencies": {
    "@dreamboard-games/api-client": "workspace:*",
    "@dreamboard-games/gameplay-authority-client": "0.1.0-alpha.1",
    "@dreamboard-games/sdk": "0.4.0-alpha.0",
    "@dreamboard-games/ui-host-runtime": "0.1.0-alpha.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "citty": "^0.2.2",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.17.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "^5.4.21",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-sql": "^0.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
