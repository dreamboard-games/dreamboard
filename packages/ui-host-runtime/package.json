{
  "name": "@dreamboard-games/ui-host-runtime",
  "version": "0.1.0-alpha.8",
  "description": "Dreamboard host session runtime: session store, gameplay transports, and host-side controls shared by the Dreamboard web app and the dreamboard dev host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard.git"
  },
  "homepage": "http://dreamboard.games/",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "rm -f tsconfig.build.tsbuildinfo && pnpm run build",
    "test": "bun test",
    "check": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@dreamboard-games/api-client": "workspace:*",
    "@dreamboard-games/sdk": "0.5.0-alpha.0",
    "@dreamboard-games/gameplay-authority-client": "workspace:*",
    "@dreamboard-games/gameplay-authority-protocol": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@dreamboard/typescript-config": "workspace:*",
    "typescript": "^5.9.3",
    "@types/node": "^24.12.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "exports": {
    ".": {
      "dreamboard-source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "dreamboard-source": "./src/components/index.ts",
      "bun": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./runtime": {
      "dreamboard-source": "./src/runtime/index.ts",
      "bun": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  }
}
