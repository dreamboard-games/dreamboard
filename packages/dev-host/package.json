{
  "name": "@dreamboard-games/dev-host",
  "version": "0.2.0-alpha.1",
  "type": "module",
  "description": "Project-local offline Dreamboard development host.",
  "bin": {
    "dreamboard-dev": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc",
    "check": "pnpm build && pnpm test",
    "pack:publish": "pnpm build && pnpm pack",
    "test": "playwright test"
  },
  "dependencies": {
    "@dreamboard-games/browser-gameplay-runtime": "workspace:*",
    "@dreamboard-games/sdk": "0.5.0-alpha.2",
    "esbuild": "0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3",
    "postcss": "8.5.28",
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "@playwright/test": "1.61.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
