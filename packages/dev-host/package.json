{
  "name": "@dreamboard-games/dev-host",
  "version": "0.1.30-alpha.18",
  "description": "Project-local Dreamboard development host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard.git"
  },
  "homepage": "http://dreamboard.games/",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/dev-host/*.html",
    "src/dev-host/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run scripts/test.ts",
    "stage:publish": "pnpm --dir ../../apps/dreamboard-cli run release-set:generate && pnpm run build && tsx ../../apps/dreamboard-cli/scripts/stage-dev-host-package.ts",
    "pack:publish": "pnpm run stage:publish && npm pack --dry-run .publish/package"
  },
  "dependencies": {
    "@dreamboard-games/api-client": "workspace:*",
    "@dreamboard-games/sdk": "0.4.0-alpha.5",
    "@dreamboard-games/ui-host-runtime": "0.1.0-alpha.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "^5.4.21",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@dreamboard/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@dreamboard-games/sdk": "0.4.0-alpha.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
