{
  "name": "@dreamboard/ui-sdk",
  "version": "0.0.42",
  "private": false,
  "description": "UI SDK for dreamboard plugin development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reducer": {
      "bun": "./src/reducer.ts",
      "types": "./dist/reducer.d.ts",
      "import": "./dist/reducer.js"
    },
    "./components": {
      "bun": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./defaults": {
      "bun": "./src/defaults/index.ts",
      "types": "./dist/defaults/index.d.ts",
      "import": "./dist/defaults/index.js"
    },
    "./primitives": {
      "bun": "./src/primitives/index.ts",
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./internal": {
      "bun": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./types/runtime-api": {
      "bun": "./src/types/runtime-api.ts",
      "types": "./dist/types/runtime-api.d.ts",
      "import": "./dist/types/runtime-api.js"
    },
    "./plugin-styles.css": "./dist/plugin-styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b && cp src/plugin-styles.css dist/plugin-styles.css && rollup -c rollup.config.js",
    "postbuild": "echo '✅ Generated ui-sdk.d.ts'",
    "typecheck": "tsc -b --pretty false",
    "dev": "cosmos",
    "cosmos": "cosmos",
    "cosmos:export": "cosmos-export",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "bun test",
    "test:unit": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dreamboard/sdk-types": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.1.5",
    "vaul": "^1.1.2",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@dreamboard/eslint-config": "workspace:*",
    "@dreamboard/tailwind-config": "workspace:*",
    "@dreamboard/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.34.0",
    "pem": "^1.14.8",
    "postcss": "^8.5.3",
    "react-cosmos": "^7.1.0",
    "react-cosmos-plugin-vite": "^7.1.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.28.1",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "5.7.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "zod": "4.4.3"
  }
}
