{
  "name": "@dreamboard/app-sdk",
  "version": "0.0.42",
  "description": "App authoring SDK for Dreamboard game logic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./reducer": {
      "bun": "./src/reducer.ts",
      "types": "./dist/reducer.d.ts",
      "import": "./dist/reducer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/fix-dist-imports.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.type-tests.json",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "bun test",
    "test:unit": "bun test"
  },
  "dependencies": {
    "@dreamboard/reducer-contract": "workspace:*",
    "@dreamboard/sdk-types": "workspace:*"
  },
  "devDependencies": {
    "@dreamboard/eslint-config": "workspace:*",
    "@dreamboard/typescript-config": "workspace:*",
    "@dreamboard/workspace-codegen": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  }
}
