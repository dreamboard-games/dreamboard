{
  "name": "dreamboard",
  "version": "0.0.1",
  "private": true,
  "description": "Dreamboard public source repo: the dreamboard CLI, docs, skills, and public packages.",
  "scripts": {
    "authoring:api-client-candidate": "pnpm --dir packages/api-client authoring:candidate",
    "build": "pnpm --dir apps/dreamboard-cli run build",
    "check:authoring-version-authority": "pnpm --dir apps/dreamboard-cli run check:authoring-version-authority",
    "cli:boundary-check": "pnpm --dir apps/dreamboard-cli exec tsx scripts/check-cli-core-boundary.ts",
    "dev-host:pack-smoke": "pnpm --filter=@dreamboard-games/dev-host run pack:publish",
    "docs:broken-links": "pnpm mint broken-links",
    "docs:dev": "pnpm mint dev",
    "skills:sync-docs": "pnpm --dir apps/dreamboard-cli run sync:skill-docs",
    "docs:validate": "pnpm mint validate",
    "typecheck": "pnpm --dir apps/dreamboard-cli run typecheck",
    "test": "pnpm --dir apps/dreamboard-cli run test",
    "stage:publish": "pnpm --dir apps/dreamboard-cli run stage:publish",
    "pack:publish": "pnpm --dir apps/dreamboard-cli run pack:publish"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "devDependencies": {
    "mint": "4.2.626"
  }
}
