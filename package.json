{
  "name": "dreamboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dreamboard offline authoring tools, browser runtime, docs, and skills.",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "vitest run scripts/release-candidate.test.ts && pnpm -r --workspace-concurrency=1 --if-present check",
    "candidate:pack": "node scripts/build-authoring-release-candidate.ts",
    "candidate:verify": "node scripts/verify-authoring-release-candidate.ts && node scripts/verify-installed-offline-candidate.ts",
    "verify:package": "pnpm check && pnpm candidate:pack && pnpm candidate:verify",
    "docs:validate": "pnpm mint validate",
    "docs:broken-links": "pnpm mint broken-links",
    "docs:dev": "pnpm mint dev"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "mint": "4.2.626",
    "tsx": "^4.22.4",
    "vitest": "4.1.10"
  }
}
